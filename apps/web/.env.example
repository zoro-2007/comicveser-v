# Backend API URL
# Option 1 (Recommended on Vercel with same-origin proxy): set NEXT_PUBLIC_API_URL=/api and API_INTERNAL_URL=https://your-api.onrender.com/api
# Option 2 (Direct cross-origin calls): set NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=https://comicverse-api.onrender.com/api

# Public site URL (used for SEO metadata, canonical links, and sitemaps; auto-detected on Vercel if omitted)
NEXT_PUBLIC_SITE_URL=https://comicverse.vercel.app

# Google OAuth 2.0 Client ID (same Web Client ID configured in GOOGLE_CLIENT_ID on the API)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
